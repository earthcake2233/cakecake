{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.vue"],
  "exclude": [
    "src/__tests__",
    "node_modules",
    "dist",
    "**/*.broken",
    "**/*.corrupt",
    "**/*.corrupt*",
    "**/*.bak-*",
    "**/*.before-rebuild",
    "**/*.corrupted-backup"
  ]
}
