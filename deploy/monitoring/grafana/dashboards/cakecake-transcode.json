    "panels": [
        {
            "type": "timeseries",
            "title": "Transcode Job Rate by Result",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "drawStyle": "line",
                        "fillOpacity": 10,
                        "lineWidth": 2,
                        "showPoints": "never"
                    },
                    "min": 0,
                    "unit": "ops"
                },
                "overrides": []
            },
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom",
                    "showLegend": true
                },
                "tooltip": {
                    "mode": "multi",
                    "sort": "desc"
                }
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 16
            },
            "targets": [
                {
                    "expr": "sum(rate(cakecake_transcode_jobs_total{instance=~\"$instance\"}[5m])) by (result, instance)",
                    "interval": "15s",
                    "legendFormat": "{{result}} {{instance}}",
                    "refId": "A"
                }
            ]
        },
