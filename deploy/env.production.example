# /opt/minibili/.env — 生产环境示例（复制后修改，勿提交仓库）
#
# 所有密钥用 <generate-...> 占位；生成方式见括号内命令。
# 可复用 scripts/init_env.py 生成后手工替换为生产值。

APP_ENV=production
HTTP_ADDR=127.0.0.1:8080

# JWT 签名密钥（部署脚本合并时若服务器已有则保留）：openssl rand -hex 32
JWT_SECRET=

# MySQL 连接串（生产建议专用账号；已有则保留）
MYSQL_DSN=

REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=<generate-redis-password>
REDIS_DB=0
REDIS_POOL_SIZE=10

RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/

# Elasticsearch（HTTPS + 白名单放行本机公网 IP）
ELASTICSEARCH_URL=https://<instance>.es.tencentcloud.com:9200
ELASTICSEARCH_USERNAME=elastic
# Elasticsearch 密码（已有则保留）
ELASTICSEARCH_PASSWORD=

SENSITIVE_WORDS_FILE=./configs/sensitive_words.txt
TEMP_UPLOAD_DIR=./data/tmp
FFPROBE_PATH=/usr/bin/ffprobe
FFMPEG_PATH=/usr/bin/ffmpeg
IP2REGION_V4_XDB=./configs/ip2region_v4.xdb

# 阿里云 OSS（按需填写）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_ENDPOINT=
OSS_PUBLIC_URL_PREFIX=

ADMIN_SEED_USERNAME=admin
# 仅首次建库生效（已有则保留）：openssl rand -hex 16
ADMIN_SEED_PASSWORD=

VIDEO_REVIEW_REQUIRED=true
ARTICLE_REVIEW_REQUIRED=true
SEED_DEMO_DATA=false

# 关闭网页端视频文件上传与转码
VIDEO_UPLOAD_DISABLED=true

# AI 助手（可选）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
AGENT_BOT_USERNAME=minibili_ai
AGENT_ENABLED=true
AGENT_MAX_HISTORY=20
AGENT_HISTORY_TTL=720h
AGENT_DAILY_QUOTA=80
AGENT_REQUEST_TIMEOUT=90s

# ── 可观测性（compose 监控栈）──
# Prometheus 抓取 /metrics 的 Bearer 令牌（已有则保留）：openssl rand -hex 32
METRICS_TOKEN=
# Grafana 管理员：用户默认 admin，密码随机（已有则保留）
GRAFANA_ADMIN_PASSWORD=
# 告警出口 webhook（本机监控不需要；云上无 Alertmanager 时可留空）
ALERTMANAGER_WEBHOOK_URL=
PROMETHEUS_RETENTION=30d
PROMETHEUS_CLUSTER=production
