# cakecake 后端环境变量示例
#
# 使用方式（三选一）：
#   1) 全新初始化（推荐）：python3 scripts/init_env.py
#      生成 .env 并自动填入随机强密钥（chmod 600）
#   2) 手动：cp .env.example .env，再为下方「必填」项填入自己的值
#   3) 已有 .env 时补全/整理：python3 scripts/init_env.py --refresh
#      保留已有真实值，仅填充缺失/空的密钥
#
# 安全约定：
#   - .env 已被 .gitignore 排除，禁止提交到仓库；
#   - 示例文件只允许空值/占位符，不写真实或默认密钥；
#   - docker compose 对必填密钥使用 ${VAR:?} 强校验，缺失时启动直接报错，
#     避免「默认弱口令悄悄上线」。

# ── 必填（无默认值；缺失时 compose 启动会直接报错）────────────────────
# JWT 签名密钥，建议：openssl rand -hex 32
JWT_SECRET=
# 本地直跑后端用的 MySQL DSN（docker compose 会自动由 MYSQL_ROOT_PASSWORD 拼装，这里可不填）
MYSQL_DSN=
# compose 的 MySQL root 密码（首次初始化 MySQL 数据卷时生效；建议用 hex，避免 @ : 等 DSN 特殊字符）
MYSQL_ROOT_PASSWORD=
# 运营后台首个管理员密码（仅当 admins 表为空时创建一次）
ADMIN_SEED_PASSWORD=
# Prometheus 抓取 /metrics 的 Bearer 令牌，建议：openssl rand -hex 32
METRICS_TOKEN=
# Grafana 管理员密码
GRAFANA_ADMIN_PASSWORD=

# ── HTTP ──
APP_ENV=development
# Graceful shutdown timeout (max wait for background tasks).
# SHUTDOWN_TIMEOUT=30s
# DB migration strategy: APP_ENV=production defaults to goose-only (DB_AUTO_MIGRATE=false),
# development defaults to GORM AutoMigrate (DB_AUTO_MIGRATE=true).
# DB_AUTO_MIGRATE=1
HTTP_ADDR=:8080

# ── Redis（播放计数增量、弹幕冷却、全站热搜统计、Refresh Token 黑名单等）──
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s
REDIS_POOL_SIZE=20

# ── Elasticsearch（搜索页 /api/v1/search；为空则搜索返回 search_status=unavailable）──
# 也支持 OpenSearch / Bonsai（HTTPS + 用户名密码；URL 勿含 @ 内嵌凭证）
ELASTICSEARCH_URL=http://127.0.0.1:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# ── 敏感词（弹幕、评论、搜索热搜统计过滤；文件不存在则相关 UGC 会被拒绝）──
SENSITIVE_WORDS_FILE=./configs/sensitive_words.txt

# ── 消息队列（视频转码等，可选）──
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/

# ── 阿里云 OSS（视频/封面上传，可选）──
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_ENDPOINT=
OSS_PUBLIC_URL_PREFIX=

# ── 其它 ──
TEMP_UPLOAD_DIR=./data/tmp
# 单次 ffmpeg 转码/截帧超时（进程挂死会被杀掉，避免阻塞 worker）
TRANSCODE_TIMEOUT=10m
FFPROBE_PATH=ffprobe
FFMPEG_PATH=ffmpeg
IP2REGION_V4_XDB=./configs/ip2region_v4.xdb
# 从 https://github.com/lionsoul2014/ip2region 下载 ip2region_v4.xdb 放到 configs/（仓库 .gitignore 已排除）
IP2REGION_DEV_CLIENT_IP=

# ── 运营后台首个管理员（用户名非密钥，可默认；密码见上方必填项）──
ADMIN_SEED_USERNAME=admin

# ── 视频审核：转码成功后进入 pending_review，运营通过后才会 published 并进入搜索（默认 true）──
VIDEO_REVIEW_REQUIRED=true

# ── 专栏审核：投稿后进入 pending_review，运营通过后才会 published 并进入搜索（默认 true）──
ARTICLE_REVIEW_REQUIRED=true

# ── 关闭网页端视频文件上传与转码（仍允许保存稿件元数据草稿；默认 false）──
VIDEO_UPLOAD_DISABLED=false

# ── Demo data（docker compose 本地体验默认开启；生产务必关闭）──
SEED_DEMO_DATA=true
# DEMO_USER_PASSWORD=demo123456

# ── AI 助手（消息中心固定「cakecake AI」会话；DeepSeek OpenAI 兼容接口）──
# 为空则仅创建助手会话，用户发消息后返回「未配置」提示
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
AGENT_BOT_USERNAME=minibili_ai
AGENT_ENABLED=true
AGENT_MAX_HISTORY=20
AGENT_HISTORY_TTL=720h
AGENT_DAILY_QUOTA=80
AGENT_REQUEST_TIMEOUT=90s

# ── 全局限流（Redis token bucket，默认关闭）──
# RATE_LIMIT_ENABLED=false
# RATE_LIMIT_RATE=20
# RATE_LIMIT_BURST=50

# ========== Docker Compose（可选；仅 compose 使用，直跑后端可忽略）==========
# 端口默认只绑定 127.0.0.1；生产请收敛到内网/反向代理后
MYSQL_DATABASE=cakecake
MYSQL_PORT=3306
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
ES_PORT=9200
BACKEND_PORT=8080
WEB_PORT=8888
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
PROMETHEUS_RETENTION=15d
PROMETHEUS_CLUSTER=default
# 告警出口（飞书/钉钉/Slack/Opsgenie 等 webhook；占位地址仅保证本地能启动）
ALERTMANAGER_WEBHOOK_URL=http://127.0.0.1:9999/webhook
# 可选：生产服务器 /metrics 使用与本地不同的 token 时填写；留空则与 METRICS_TOKEN 相同
# METRICS_TOKEN_CLOUD=
# 前端构建标志：false 显示网页上传入口（需 OSS_* 且 VIDEO_UPLOAD_DISABLED=false）
VITE_VIDEO_UPLOAD_DISABLED=true
